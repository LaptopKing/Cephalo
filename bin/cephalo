#!/usr/bin/env bash
# Cephalo - Sovereign Local Memory & Cognitive Coprocessor CLI Runner
REAL_BIN="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_BIN")/.." && pwd)"

# Vector semantic search and cleanup execute via Python LanceDB engine
if [ "$1" = "search" ] || [ "$1" = "clean" ]; then
    PYTHON_CMD="python3"
    if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
        PYTHON_CMD="$SCRIPT_DIR/.venv/bin/python"
    elif ! command -v python3 &> /dev/null; then
        PYTHON_CMD="python"
    fi
    exec "$PYTHON_CMD" "$SCRIPT_DIR/brain.py" "$@"
fi

# Ultra-low latency native Rust engine execution (sub-5ms)
RUST_BIN="$SCRIPT_DIR/rust/target/release/cephalo"
if [ -x "$RUST_BIN" ]; then
    # Execute Rust binary and capture stderr for clean fallback if subcommand is unrecognized
    RUST_ERR=$(mktemp)
    "$RUST_BIN" "$@" 2>"$RUST_ERR"
    EXIT_CODE=$?
    # Exit code 2 from clap indicates unrecognized subcommand/option
    if [ $EXIT_CODE -ne 2 ]; then
        cat "$RUST_ERR" >&2
        rm -f "$RUST_ERR"
        exit $EXIT_CODE
    fi
    rm -f "$RUST_ERR"
fi

# Fallback to Python for legacy or extended commands
PYTHON_CMD="python3"
if [ -f "$SCRIPT_DIR/.venv/bin/python" ]; then
    PYTHON_CMD="$SCRIPT_DIR/.venv/bin/python"
elif ! command -v python3 &> /dev/null; then
    PYTHON_CMD="python"
fi
exec "$PYTHON_CMD" "$SCRIPT_DIR/brain.py" "$@"
