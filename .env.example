# ==============================================================================
# Cephalo - Local Environment Configuration (.env)
# ==============================================================================
# Copy this file to '.env' (in the same directory) and fill in your details.
# This file is strictly excluded from Git by .gitignore to protect your privacy.

# --- Outbound Email (SMTP) Configuration ---
# Gmail:   host: smtp.gmail.com          port: 587
# Outlook: host: smtp-mail.outlook.com   port: 587
# Yahoo:   host: smtp.mail.yahoo.com     port: 587

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# --- Optional Web Search Providers (Default is 100% Free Zero-Key Fallback) ---
# TAVILY_API_KEY=tvly-xxxxxxxxxxxx
# EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
